PORT=3001
# Optional: comma-separated origins (defaults to permissive CORS in dev)
# CORS_ORIGIN=http://localhost:5173

# Required in production for stable auth tokens (min 16 chars)
# JWT_SECRET=replace-with-long-random-string

# Recommended: Edamam Nutrition Analysis (POST /api/nutrition-details + GET /api/nutrition-data).
# https://developer.edamam.com/
EDAMAM_APP_ID=
EDAMAM_APP_KEY=

# Optional: USDA FoodData Central — used automatically if Edamam fails or is unset (defaults to DEMO_KEY for light testing).
# https://fdc.nal.usda.gov/api-key-signup
# USDA_API_KEY=

# Optional: OpenAI parses messy meal text or photos into ingredient lines (no invented nutrition math).
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL_PARSE=gpt-4o-mini
# OPENAI_MODEL_VISION=gpt-4o-mini

# Optional (often-free tier): Google Gemini reads photos when OpenAI is unset or fails. https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_VISION_MODEL=gemini-2.0-flash

# Optional: SQLite path (defaults to server/data/app.db)
# DATABASE_PATH=
